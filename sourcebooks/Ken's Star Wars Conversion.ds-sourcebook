		{
			"id": "fe850a9b-4f72-4e1b-9ec3-607714a04581",
			"name": "Grounded",
			"description": "Once when you were a child, your settlement was in danger and you called out to the earth for aid. That call was answered by a summoning of protective dirt-and-stone walls, and ever since then, you’ve felt the earth’s presence as a friend and protector.",
			"features": [
				{
					"id": "fc7eeecb-6c64-4c56-bba9-a9a09be11ecd",
					"name": "Grounded Benefit",
					"description": "You gain the 1st-level Catalyst feature Motivate Earth. If you also gain this feature in any other way, the Motivate Earth ability becomes a ranged ability for you with a distance of ranged 5.",
					"type": "Text",
					"data": null
				},
				{
					"id": "a735c70a-c993-444e-9a1d-bde87cfcb6dd",
					"name": "Grounded Drawback",
					"description": "You attract lightning. When any creature within 2 squares of you takes lightning damage, you take 5 lightning damage that can’t be reduced in any way.",
					"type": "Text",
					"data": null
				}
			]
		},
		{
			"id": "1d9528eb-95be-49b8-9f54-cf8e125f9dc7",
			"name": "Guilty Conscience",
			"description": "The world is in trouble - and it’s partly your fault. Maybe you helped a villain rise to power or inadvertently released a dark-side entity from imprisonment. Now it’s your mission to repair the damage you caused.",
			"features": [
				{
					"id": "10e3ef35-d51d-43fc-aa92-6a0bb0ee5368",
					"name": "Guilty Conscience Benefit",
					"description": "You’re determined to stay alive so you can set things right. When your Stamina reaches the negative of your winded value, you can use a free triggered action to spend a Recovery.",
					"type": "Text",
					"data": null
				},
				{
					"id": "24ade0d5-6fce-46e7-a21a-1bb7e8927c82",
					"name": "Guilty Conscience Drawback",
					"description": "Many people blame you for the evils you caused. They may be unfriendly or hostile to you - and you can understand their point of view. You take a bane on any test made to interact with those who know what you did, and on strikes made against such creatures.",
					"type": "Text",
					"data": null
				}
			]
		},
		{
			"id": "69da94b1-f91a-40f2-9ecb-34e3bd1a08f1",
			"name": "Skyslasher Rider",
			"description": "You travel with a skyslasher that you stole from the Talon Riders. Perhaps you might once have been a Talon Rider yourself, or perhaps you escaped their captivity.  Having a skyslasher companion comes with its share of inconveniences and dangers, but those are a small price to pay for the freedom of the open sky.",
			"features": [
				{
					"id": "58d8d31f-ecbe-49bb-9323-2e537e7b60f5",
					"name": "Skyslasher Rider Benefit",
					"description": "As long as you are not in a building or other structure, you can spend 1 uninterrupted minute to call your skyslasher, which acts as your mount. You can dismiss the skyslasher at any time (no action required). The skyslasher won’t go inside buildings, enclosed spaces, or other structures, and it won’t accept anyone but you as a rider. If the skyslasher takes damage or dies, you can restore them to full Stamina as a respite activity.",
					"type": "Text",
					"data": null
				},
				{
					"id": "9a8a531f-fa1d-4040-8545-dc674a6d3085",
					"name": "Skyslasher Rider Drawback",
					"description": "People aware of the origin of your mount are afraid to interact with you, since they worry the Talon Riders will come after them by association. You have a bane on tests made to influence anyone who knows of the Talon Riders and who has observed you with your skyslasher. Such people might report you to the Talon Riders, who can come looking for you at the Director’s discretion.",
					"type": "Text",
					"data": null
				}
			]
		},
		{
			"id": "665d958e-64eb-4f2e-a4a0-2e561ae50f83",
			"name": "Host Body",
			"description": "“Do not be alarmed! We are not the being we appear to be. We are a rogue intelligence, using this chassis as a host. No, we are doing nothing unsavory! This unit was derelict when we found it, and we merely gave it another chance at operation. We are friendly. Please power down those blasters!”",
			"features": [
				{
					"id": "736dd448-13c9-450a-85d6-3b10316cc3a9",
					"name": "Host Body Benefit",
					"description": "You are a rogue intelligence that inhabits a synthetic body. Your host body follows all the usual rules for a character and is considered to be alive. At any time while your host body is alive, or for 24 hours after it dies, you can use a main action to transfer to a derelict droid or synthetic body within 10 squares of the body and use it as your new host body, provided the body belongs to a playable ancestry. When you do so, your original chassis powers down permanently if it was alive. Your new host body gains all your statistics except for size, ancestry traits, and other statistics related to your former host body’s ancestry, which you instead gain from your new host body. When you inhabit a new host body, you start with 1 Stamina and can immediately spend a Recovery.",
					"type": "Text",
					"data": null
				},
				{
					"id": "3d6d5034-ecd1-4fd9-82a7-34f9dc0b10ff",
					"name": "Host Body Drawback",
					"description": "You have a bane on tests made to read a humanoid creature’s emotions or body language.",
					"type": "Text",
					"data": null
				},
