		},
		{
			"id": "262614ce-68d4-4e55-87c4-465ff04118e1",
			"name": "Lightning-Struck",
			"description": "You were caught in a storm and struck by lightning - but something saved you from death. Perhaps it was a Force-given miracle, a latent psionic gift, or the power of a helpful Catalyst, but you absorbed the lightning into your body. It’s always there now, simmering under the surface.",
			"features": [
				{
					"id": "b109fc96-d341-4e8c-bc90-ca152ed5d7ab",
					"name": "Lightning-Struck Benefit",
					"description": "When you regain Stamina in combat, you gain 1 surge. Whenever you spend a surge to deal extra damage, you can make that extra damage into lightning damage.",
					"type": "Text",
					"data": null
				},
				{
					"id": "13417f9b-c8a4-407d-89d4-47b5a56eaee3",
					"name": "Lightning-Struck Drawback",
					"description": "Whenever you are wet, you have damage weakness 5.",
